        {
            "parameters": {
                "jsCode": "// 1. Recogemos todo lo que llega de las dos flechas\nconst allItems = $input.all();\nconst groups = {};\n\n// Si no llega NADA de clínicas nuevas, paramos aquí para evitar errores.\n// (Asumimos que si no hay clínicas, no hay nada que insertar en onboarding)\nconst hasClinics = allItems.some(item => item.json.city !== undefined || item.json.address !== undefined);\nif (!hasClinics) {\n  return []; // Retorna vacío y el nodo SQL no se ejecutará\n}\n\nfor (const item of allItems) {\n  const data = item.json;\n  \n  // Validación: Si el item está vacío, lo saltamos\n  if (!data.clinic_name) continue;\n\n  const clinicName = data.clinic_name;\n\n  // CREAR GRUPO (Solo si es una clínica nueva válida)\n  if (!groups[clinicName]) {\n     // Solo creamos el grupo si detectamos que es una clínica (tiene dirección)\n     // O si es un doctor, solo lo procesamos si ya existe el grupo (clínica padre)\n     if (data.city || data.address) {\n        groups[clinicName] = {\n          clinic_name: clinicName,\n          clinic_phone: data.whatsapp_phone || data.clinic_phone,\n          country: data.country,\n          city: data.city,\n          address: data.address,\n          subscription_plan: data.subscription_plan || 'Basic',\n          branch_name: data.branch_name || 'Sede Principal',\n          opening_time: data.working_hour_min || '08:00',\n          closing_time: data.working_hour_max || '18:00',\n          evaluation_template_name: data.evaluation_name || 'General',\n          evaluation_questions: data.evaluation_template,\n          doctors_list: [],\n          onboarding_status: 'Ready'\n        };\n     }\n  }\n\n  // SI ES DOCTOR (Y la clínica padre existe en el grupo)\n  if (data.doc_first_name && groups[clinicName]) {\n    groups[clinicName].doctors_list.push({\n      first_name: data.doc_first_name,\n      last_name: data.doc_last_name,\n      specialty: data.doc_specialty\n    });\n  }\n}\n\nreturn Object.values(groups).map(g => ({ json: g }));"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1184,
                144
            ],
            "id": "542a9a62-1208-4453-878a-f8d62c6216ce",
            "name": "Code in JavaScript"
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "WITH new_onboarding AS (\n  INSERT INTO medical.clinic_onboarding \n  (\n    clinic_name, \n    clinic_phone, \n    country, \n    city, \n    address, \n    subscription_plan, \n    doctors_list, \n    branch_name, \n    opening_time, \n    closing_time, \n    evaluation_template_name, \n    evaluation_questions,\n    onboarding_status\n  )\n  VALUES (\n    $1, $2, $3, $4, $5, $6, \n    $7::jsonb, \n    $8, $9, $10, $11, $12,\n    'Ready'\n  )\n  RETURNING id\n)\nSELECT medical.process_clinic_onboarding(id) FROM new_onboarding;",
                "options": {
                    "queryReplacement": "={{ $json.clinic_name }}, {{ $json.clinic_phone }}, {{ $json.country }}, {{ $json.city }}, {{ $json.address }}, {{ $json.subscription_plan }}, {{ JSON.stringify($json.doctors_list) }}, {{ $json.branch_name }}, {{ $json.opening_time }}, {{ $json.closing_time }}, {{ $json.evaluation_template_name }}, {{ $json.evaluation_questions }}"
                }
